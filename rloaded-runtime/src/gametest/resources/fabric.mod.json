{
  "schemaVersion": 1,
  "id": "rloaded-gametest",
  "version": "${version}",
  "name": "Rloaded game tests",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.calamech.rloaded.gametest.GameTestContent"],
    "client": ["io.github.calamech.rloaded.gametest.client.GameTestClientContent"],
    "server": ["io.github.calamech.rloaded.gametest.RegistrySyncServer"],
    "fabric-client-gametest": [
