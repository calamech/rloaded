    "fabric-gametest": [
      "io.github.calamech.rloaded.gametest.AdminAddGameTest",
      "io.github.calamech.rloaded.gametest.BlockEntityCyclingGameTest",
      "io.github.calamech.rloaded.gametest.EntityCyclingGameTest",
      "io.github.calamech.rloaded.gametest.HotAddGameTest",
      "io.github.calamech.rloaded.gametest.HotAddRefusalGameTest",
