{
  "schemaVersion": 1,
  "id": "rloaded",
  "version": "${version}",
  "name": "Rloaded",
  "description": "Adds Fabric mods to a running game.",
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/calamech/rloaded"
  },
  "environment": "*",
  "mixins": ["rloaded.mixins.json"],
  "jars": [${jars}],
  "entrypoints": {
    "main": ["io.github.calamech.rloaded.runtime.RloadedRuntime"],
    "client": ["io.github.calamech.rloaded.runtime.RloadedClient"]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
